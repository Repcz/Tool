// sing-box 1.14.x 客户端配置（fake-ip 版）
// 支持：Linux、macOS、Windows、Android、iOS
// 校验：sing-box check -c sing-box.example.jsonc
// 运行：sing-box run -c sing-box.example.jsonc
{
    // 日志：level 可选 trace/debug/info/warn/error/fatal
    "log": {
        "level": "info",
        "output": "sing-box.log",
        "timestamp": true
    },
    // ---------------------------------------------------------------- DNS
    // fake-ip 模式：本地域名解析立即返回假 IP（198.18.0.0/15），由 TUN 截获连接后
    // 通过预匹配反查真实域名，路由无需等待 DNS 上游响应，连接建立延迟最低。
    "dns": {
        "servers": [
            // 静态 hosts：解决 DoH 域名自身的引导解析，避免死循环
            {"tag": "hosts_fix", "type": "hosts", "predefined": {
                "dns.alidns.com": ["223.5.5.5", "223.6.6.6"],
                "doh.pub": ["1.12.12.21", "120.53.53.53"],
                "cloudflare-dns.com": ["1.1.1.1", "1.0.0.1"]}
            },
            {"tag": "tx-udp", "type": "udp", "server": "119.29.29.29"},
            {"tag": "ali-udp", "type": "udp", "server": "223.5.5.5"},
            {"tag": "ali-doh", "type": "https", "server": "dns.alidns.com", "domain_resolver": "hosts_fix"},
            {"tag": "tx-doh", "type": "https", "server": "doh.pub", "domain_resolver": "hosts_fix"},
            {"tag": "cf-doh", "type": "https", "server": "cloudflare-dns.com", "domain_resolver": "hosts_fix", "detour": "Proxy"},
            // fake-ip 地址池：只在本机 TUN 内可见，不占用公网
            {"tag": "fakeip", "type": "fakeip", "inet4_range": "198.18.0.0/15", "inet6_range": "fc00::/18"},
            // 系统解析：处理 .local/.lan 等邻居域名（mDNS/NetBIOS 类）
            {"tag": "local", "type": "local", "neighbor_domain": [".local", ".lan"]}
        ],
        // DNS 规则：自上而下匹配，首条命中即生效
        "rules": [
            // 广告/追踪域名直接拒绝解析
            {"rule_set": ["Reject"], "action": "reject"},
            // 拒绝 HTTPS(65) 记录：部分客户端借 ECH 隐藏 SNI 导致嗅探失效
            {"query_type": ["HTTPS", "SVCB"], "action": "reject"},
            // 本地域名与连通性探测域名走系统解析（不可经代理）
            {"domain_suffix": ["lancache.steamcontent.com", "10099.com.cn", "msftconnecttest.com", "msftncsi.com", "local", "lan", "home", "internal", "corp", "example.com"], "server": "local"},
            // Direct 模式使用真实 DNS
            {"clash_mode": "Direct", "action": "route", "server": "local"},
            // A/AAAA 查询全部走 fake-ip（rewrite_ttl=1 让客户端尽快丢弃假记录）
            {"query_type": ["A", "AAAA"], "action": "route", "server": "fakeip", "rewrite_ttl": 1},
            // Global 仍需 fake-ip 以保持全局代理下的域名路由能力；
            {"clash_mode": "Global", "action": "route", "server": "fakeip"},
            // DNS 竞速：向阿里/腾讯 DoH 同时发起评估查询（带 tag 供后续引用）。
            {"action": "evaluate", "server": "ali-doh", "tag": "ali", "speculative": true},
            {"action": "evaluate", "server": "tx-doh", "tag": "tencent", "speculative": true},
            // 竞态判定 #1（污染防护）：应答含私有/保留地址，该竞态规则「不匹配」→ 规则继续等待另一方；
            // 若双方均污染，最终落到 final 上游重试。
            {"match_response": "ali", "ip_is_private": true, "action": "reject", "race": true},
            {"match_response": "tencent", "ip_is_private": true, "action": "reject", "race": true},
            // 竞态判定 #2：先返回 NOERROR 且不含私有地址的一方胜出，立即采用其响应，取消另一方。
            // 效果：任一上游故障或返回污染结果时自动切换，DNS 解析稳定性优于单上游
            {"match_response": "ali", "response_rcode": "NOERROR", "action": "respond", "race": true},
            {"match_response": "tencent", "response_rcode": "NOERROR", "action": "respond", "race": true}
        ],
        // 记录 IP → 域名反向映射：TUN 场景下 fake-ip 反查之外的补充，混合入站也能按域名路由
        "reverse_mapping": true,
        // 仅解析 IPv4：配合 fake-ip inet4_range，避免 AAAA 空响应拖慢连接
        "strategy": "ipv4_only",
        // 乐观缓存：TTL 过期先返回旧记录并后台刷新
        "optimistic": true,
        // 未命中任何规则时使用 CF DNS
        "final": "cf-doh"
    },
    // ------------------------------------------------------------ 实验性
    // 储存 fake-ip
    "experimental": {
        // 持久化缓存：重启后保留 DNS\fake-ip 缓存与规则集元数据
        "cache_file": {
            "enabled": true,
            "path": "cache.db",
            "store_fakeip": true,
            "store_dns": true
        }
    },
    // -------------------------------------------------------------- 出站
    "outbounds": [
        // 默认直连出站
        {"tag": "Direct", "type": "direct"},
        // 请将 outbounds 替换/补充为实际节点或地区组
        {"tag": "Proxy", "type": "selector", "outbounds": ["Direct"], "default": "Direct", "interrupt_exist_connections": true},
        // 分类策略组
        {"tag": "AI", "type": "selector", "outbounds": ["Proxy"], "default": "Proxy", "interrupt_exist_connections": true},
        {"tag": "Telegram", "type": "selector", "outbounds": ["Proxy"], "default": "Proxy", "interrupt_exist_connections": true},
        // 兜底策略组：未命中任何规则的流量
        {"tag": "Final", "type": "selector", "outbounds": ["Proxy", "Direct"], "default": "Proxy", "interrupt_exist_connections": true}
    ],
    // -------------------------------------------------------------- 路由
    "route": {
        // 远程规则集：多个 tag 共享同一 URL 模板，{tag} 会被逐个 tag 替换
        "rule_set": [
            {
                "tag": ["Reject", "AI", "Telegram", "Twitter", "Google", "Microsoft", "Github", "Proxy", "ChinaDomain", "ChinaIP"],
                "type": "remote",
                "format": "binary", // .srs 二进制格式，加载更快
                "url": "https://github.com/Repcz/Tool/raw/X/sing-box/Rules/{tag}.srs",
                // 优化点：显式声明更新周期（默认 1d，写明便于维护）
                "update_interval": "1d"
            }
        ],
        // 路由规则：自上而下匹配，首条「动作终结型」规则命中即结束
        "rules": [
            // sniff：按 http/tls/quic 嗅探还原真实目标域名，使后续域名规则可匹配。
            {"action": "sniff","sniffer": ["http","tls","quic","dns"]},
            // 劫持 DNS 查询转交内部 DNS 模块，防止绕过本机 DNS。
            {"type": "logical","mode": "or","rules": [{"port": 53},{"protocol": "dns"}],"action": "hijack-dns"},
            // 内网/保留地址直连
            {"ip_is_private": true, "action": "route", "outbound": "Direct"},
            // Clash 模式覆盖（Direct / Global）
            {"clash_mode": "Direct", "action": "route", "outbound": "Direct"},
            {"clash_mode": "Global", "action": "route", "outbound": "Proxy"},
            // 广告/追踪域名拒绝
            {"rule_set": ["Reject"], "action": "reject"},
            // 分类分流
            {"rule_set": ["AI"], "action": "route", "outbound": "AI"},
            {"rule_set": ["Telegram"], "action": "route", "outbound": "Telegram"},
            // 代理域名
            {"rule_set": ["Twitter", "Google", "Microsoft", "Github", "Proxy"], "action": "route", "outbound": "Proxy"},
            // 将剩余域名目标解析为真实 IP（fake-ip 场景下先反查真实域名再走 DNS），
            // 使 ChinaIP 规则集可对「未命中 ChinaDomain 的直连域名」生效
            {"action": "resolve"},
            // 中国域名/IP 直连（位于代理规则之后，仅承接未被上游规则命中的流量）
            {"rule_set": ["ChinaDomain", "ChinaIP"], "action": "route", "outbound": "Direct"}
        ],
        // 自动探测并跟随默认网卡（Wi-Fi 切换、网卡漂移时自动更新）
        "auto_detect_interface": true,
        // HTTP 客户端与远程规则集下载的默认出站引用
        "default_http_client": "default",
        // 出站/规则集解析域名时使用的默认 DNS 服务器
        "default_domain_resolver": "ali-udp",
        // 兜底出站
        "final": "Final"
    },
    // -------------------------------------------------------- HTTP 客户端
    // 供远程规则集下载与 API 仪表盘使用
    // 注意：首次启动时 Proxy 组可能尚未就绪，规则集下载会稍作等待
    "http_clients": [
        {
            "tag": "default",
            "version": 2,
            "detour": "Proxy"
        }
    ],
    // ------------------------------------------------------------ 附加服务
    "services": [
        // 新版 API 服务（自 1.14.0 起替代 experimental.clash_api），提供 Dashboard 与 clash 风格 API
        {
            "type": "api",
            "tag": "sing-box dashboard",
            "listen": "127.0.0.1",
            "listen_port": 9091,
            // 生产环境建议设置非空 secret
            "secret": "",
            // 允许官方 Dashboard 网页跨域访问
            "access_control_allow_origin": [
                "http://sing-box-dashboard.sagernet.org",
                "http://dash.sing-box.app"
            ],
            "access_control_allow_private_network": true
        }
    ],
    // -------------------------------------------------------------- 入站
    "inbounds": [
        // 本地代理端口：供浏览器/显式代理客户端使用
        {
            "type": "mixed",
            "tag": "mixed",
            "listen": "127.0.0.1",
            "listen_port": 7080
        },
        // TUN 虚拟网卡：承载全局流量
        {
            "type": "tun",
            "tag": "tun",
            // TUN 接口地址与路由网段
            "address": [
                "172.18.0.1/30",
                "fdfe:dcba:9876::1/126"
            ],
            // macOS/Windows 图形客户端特性：自动配置系统 HTTP 代理指向 mixed 入站
            // 注意：若配置 network_namespaces 等共享选项，本字段会被静默忽略
            "platform": {
                "http_proxy": {
                    "enabled": true,
                    "server": "127.0.0.1",
                    "server_port": 7080
                }
            },
            // 栈实现：system 性能最佳，mixed 兼容性更好；按需选择 system/gvisor/mixed
            "stack": "mixed",
            // 自动接管全局路由
            "auto_route": true
        }
    ]
}

#!name=面板｜Aliyun ECS CDT Traffic
#!desc=实例当月互联网流量面板\n支持阈值自动启停实例\n@Repcz @GLM-5.3-Flash
#!category=⚙️ ▸ Function

#!arguments=access-key-id,secret-access-key,region:cn-hongkong,instance-id,quota:200,threshold:180,auto-action:false,icon:cloud,icon-color:FF6A00,ip-mode:mask,daily-notify:true
#!arguments-desc=阿里云 ECS 互联网流量面板 (CDT 口径)\n\nAccessKey 获取方式:\n    ├ 1.进入 RAM 控制台创建用户\n    └ 2.为其授权 CDT 只读 + ECS 查询/启停权限并创建 AccessKey\nregion: 实例所在区域 ID, 例:\n    cn-hongkong / cn-hangzhou / ap-southeast-1\ninstance-id: ECS 实例 ID, 例: i-bp1xxxxxxxxxxxxx\nquota: 当月互联网流量配额 (GB), 用于计算百分比\nthreshold: 流量阈值 (GB), 达到后停止实例, 默认 180\nauto-action: 是否允许脚本自动启停实例, 默认关闭\n    ├ true (达到阈值自动停止, 低于自动启动)\n    └ false (仅展示, 不做任何控制)\nicon: 面板图标名, 默认 cloud\nicon-color: 图标颜色, 默认 FF6A00\nip-mode: 面板 IP 显示模式, 默认 mask\n    ├ full\n    ├ mask\n    └ hide\ndaily-notify: 每日 09:00 推送流量日报(默认开启)\n    ├ true\n    └ false

[Panel]
Aliyun ECS 流量 = title="Aliyun ECS",content="正在获取...",style=info,script-name=aliyun-ecs-panel,update-interval=21600

[Script]
aliyun-ecs-panel = type=generic,script-path=https://github.com/Repcz/Tool/raw/X/Surge/Scripts/aliyun-ecs-cdt.js,timeout=60,argument="ak={{{access-key-id}}}&sk={{{secret-access-key}}}&region={{{region}}}&instance-id={{{instance-id}}}&quota={{{quota}}}&threshold={{{threshold}}}&auto-action={{{auto-action}}}&icon={{{icon}}}&icon-color={{{icon-color}}}&ip-mode={{{ip-mode}}}&mode=panel"
aliyun-ecs-daily = type=cron,cronexp="0 9 * * *",wake-system=true,timeout=60,script-path=https://github.com/Repcz/Tool/raw/X/Surge/Scripts/aliyun-ecs-cdt.js,argument="ak={{{access-key-id}}}&sk={{{secret-access-key}}}&region={{{region}}}&instance-id={{{instance-id}}}&quota={{{quota}}}&threshold={{{threshold}}}&auto-action={{{auto-action}}}&ip-mode={{{ip-mode}}}&daily-notify={{{daily-notify}}}&mode=daily"

#!name=AWS Lightsail Traffic
#!desc=AWS Lightsail 实例当月流量面板\n@Repcz\n统计口径与控制台一致(双向取大计费)
#!category=⚙️ ▸ Function

#!arguments=access-key-id,secret-access-key,region:ap-northeast-1,quota,threshold:90,icon:cloud,icon-color:FF9900,daily-notify:true
#!arguments-desc=AWS Lightsail 流量面板\n\nIAM AccessKey 获取方式:\n    ├ 1.进入 AWS 控制台 → IAM\n    ├ 2.创建用户并附加最小权限策略:\n    │    lightsail:GetInstances\n    │    lightsail:GetBundles\n    │    lightsail:GetInstanceMetricData\n    └ 3.生成 AccessKeyId / SecretAccessKey\nregion: 实例所在区域, 多个用英文逗号分隔, 例:\n    ap-northeast-1,us-east-1,ap-southeast-1\nquota: 可选, 手动指定配额(GB), 留空则自动读取套餐配额\nthreshold: 告警阈值(%), 超过后面板标红, 默认 90\nicon: 面板图标名(需已在 Surge 图标库中), 默认 cloud\nicon-color: 图标颜色, 默认 FF9900\ndaily-notify: 每日 09:00 推送流量日报(默认开启)\n    ├ true\n    └ false

[Panel]
Lightsail 流量 = title="AWS Lightsail",content="正在获取...",style=info,script-name=lightsail-panel,update-interval=21600

[Script]
lightsail-panel = type=generic,script-path=https://github.com/Repcz/Tool/raw/X/Surge/Scripts/lightsail-panel.js,timeout=60,argument="ak={{{access-key-id}}}&sk={{{secret-access-key}}}&region={{{region}}}&quota={{{quota}}}&threshold={{{threshold}}}&icon={{{icon}}}&icon-color={{{icon-color}}}&mode=panel"
lightsail-daily = type=cron,cronexp="0 9 * * *",wake-system=true,timeout=60,script-path=https://github.com/Repcz/Tool/raw/X/Surge/Scripts/lightsail-panel.js,argument="ak={{{access-key-id}}}&sk={{{secret-access-key}}}&region={{{region}}}&quota={{{quota}}}&threshold={{{threshold}}}&daily-notify={{{daily-notify}}}&mode=daily"

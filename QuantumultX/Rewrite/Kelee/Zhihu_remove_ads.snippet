#!name = 知乎去广告
#!desc = 移除HTTPDNS和QUIC传输配置，移除开屏广告、信息流广告、回答页广告，移除回答页下的相关回答、专栏卡片及圈子卡片，移除直答页面推荐知识库和提问推荐，移除评论区评论氛围满意度调查，精简首页顶部标签及我的页面。 @可莉🅥
hostname = m-cloud.zhihu.com, api.zhihu.com, www.zhihu.com, page-info.zhihu.com, zhida.zhihu.com

(?i)^https://m-cloud\.zhihu\.com/api/cloud/zhihu/config/all\? url jsonjq-response-body 'def drop_keys: {"km_httpdns_new_config_tars":true,"preFetchHttpDns":true,"httpdns_detector_use_concurrent":true,"httpdns_use_memory_cache":true,"httpdns_new_config_tars":true,"coreNetworkConf_useTars":true,"km_coreNetworkConf_useTars":true,"sugarQuicConfig":true,"quic_dns_detect_enable":true,"quicMixAB":true,"quic_downgrade_enable":true,"quic_priority_strategy":true,"quic_check_health_enable":true,"tquic_configuration":true,"networkExprimentList":true,"tars_ab_list":true,"zaSetExtraRequestHeader":true}; .data.configs |= map(select((drop_keys[.configKey] // false) | not) | if (.configValue | type) == "object" then del(.configValue.delayHttpdns, .configValue.dnsParser, .configValue.HTTPDNS) else . end)'
(?i)^https://api\.zhihu\.com/ad-style-service/request$ url reject-dict
(?i)^https://api\.zhihu\.com/commercial_api/ url reject-dict
(?i)^https://api\.zhihu\.com/root/tab/v\d(?:\?.+)?$ url jsonjq-response-body '.tab_list |= map(select(.tab_type == "follow" or .tab_type == "recommend" or .tab_type == "hot" or .tab_type == "ring_tab"))'
(?i)^https://api\.zhihu\.com/topstory/recommend\? url jsonjq-response-body '.data |= map(select(.type == "ComponentCard"))'
(?i)^https://api\.zhihu\.com/commercial_api/banners_v\d/app_float_corner\? url reject-dict
(?i)^https://api\.zhihu\.com/questions/\d+/feeds\? url jsonjq-response-body 'delpaths([["ad_info"]])'
(?i)^https://api\.zhihu\.com/next-render\?id=\d+&type=answer url reject-dict
(?i)^https://api\.zhihu\.com/comment_v\d/(answers|pins)/\d+/root_comment\? url jsonjq-response-body 'delpaths([["atmosphere_voting_config"]])'
(?i)^https://(api|page-info)(?:\.zhihu)?\.com/answers/v\d/\d+(?:\?.*)?$ url jsonjq-response-body 'delpaths([["third_business"]])'
(?i)^https://(api|page-info)(?:\.zhihu)?\.com/answers/v\d/\d+(?:\?.*)?$ url jsonjq-response-body 'delpaths([["float_search_word"]])'
(?i)^https://(api|page-info)(?:\.zhihu)?\.com/answers/v\d/\d+(?:\?.*)?$ url jsonjq-response-body '.structured_content.segments |= map(select(.type != "card"))'
(?i)^https://api\.zhihu\.com/topstory/recommend\? url jsonjq-response-body '.data[]?.children |= (if type == "array" then map(select(.id != "ring")) else . end)'
(?i)^https://api\.zhihu\.com/(articles|answers|pins)/v\d/\d+\? url jsonjq-response-body 'delpaths([["third_business"]])'
(?i)^https://api\.zhihu\.com/(articles|answers|pins)/v\d/\d+\? url jsonjq-response-body 'delpaths([["ring_info"]])'
(?i)^https://api\.zhihu\.com/(articles|answers|pins)/v\d/\d+\? url jsonjq-response-body 'delpaths([["interaction_bar_plugins"]])'
(?i)^https://api\.zhihu\.com/comment_v\d/answers/\d+/list-headers$ url jsonjq-response-body 'delpaths([["continuous_consumption_module"]])'
(?i)^https://api\.zhihu\.com/commercial_api/answer/\d+/bottom-v\d$ url reject-dict
(?i)^https://api\.zhihu\.com/related_recommend/feed/waterfall\? url reject-dict
(?i)^https://api\.zhihu\.com/podcasts/hub/v\d$ url jsonjq-response-body 'delpaths([["banners"]])'
(?i)^https://api\.zhihu\.com/search/preset_words\? url reject-dict
(?i)^https://api\.zhihu\.com/search/related_queries/question/\d+$ url reject-dict
(?i)^https://api\.zhihu\.com/search/recommend_query/v\d\? url jsonjq-response-body '.recommend_queries.queries |= map(select(.type == "normal"))'
(?i)^https://api\.zhihu\.com/search_v\d\? url jsonjq-response-body 'delpaths([["pendant"]])'
(?i)^https://api\.zhihu\.com/search/tabs\? url jsonjq-response-body '.data |= map(select(.t | IN("general", "ai_zhida", "recent", "people", "zvideo", "ring", "topic", "podcast", "column", "pin", "favlist")))'
(?i)^https://zhida\.zhihu\.com/ai_ingress/knowledge/square/categories/feeds\?categoryId=1%7D$ url reject-dict
(?i)^https://zhida\.zhihu\.com/ai_ingress/ai_chat/guidance$ url reject-dict
(?i)^https://api\.zhihu\.com/content-distribution-core/bubble/common/show$ url reject-dict
(?i)^https://www\.zhihu\.com/api/v\d/members/homepage_card$ url reject-dict
(?i)^https://api\.zhihu\.com/people/homepage_entry_v\d$ url reject-dict
(?i)^https://api\.zhihu\.com/kvip/right/my_card\? url reject-dict
(?i)^https://api\.zhihu\.com/people/self$ url jsonjq-response-body 'delpaths([["vip_info","entrance_new","right_button"]])'
(?i)^https://api\.zhihu\.com/people/self$ url jsonjq-response-body 'delpaths([["vip_info","entrance_v2"]])'
(?i)^https://api\.zhihu\.com/unlimited/go/my_card/v\d\? url reject-dict

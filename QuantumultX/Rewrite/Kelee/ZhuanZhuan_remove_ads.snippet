#!name = 转转去广告
#!desc = 移除开屏广告、应用内悬浮窗、信息流推广、商品推荐、首页弹窗，精简我的页面。 @可莉🅥
hostname = app.zhuanzhuan.com

(?i)^https://app\.zhuanzhuan\.com/zz/v2/zzlogic/getOpenScreen$ url reject-dict
(?i)^https://app\.zhuanzhuan\.com/zz/v2/zzlogic/mycontinenthomepage\? url jsonjq-response-body 'delpaths([["respData","topOpera","leftOpera"]])'
(?i)^https://app\.zhuanzhuan\.com/zz/v2/zzlogic/mycontinenthomepage\? url jsonjq-response-body 'delpaths([["respData","topOpera","rightOpera2"]])'
(?i)^https://app\.zhuanzhuan\.com/zz/v2/zzlogic/mycontinenthomepage\? url jsonjq-response-body 'delpaths([["respData","topActBanner"]])'
(?i)^https://app\.zhuanzhuan\.com/zz/v2/zzlogic/mycontinenthomepage\? url jsonjq-response-body 'delpaths([["respData","bmArea"]])'
(?i)^https://app\.zhuanzhuan\.com/zzx/transfer/getConfigInfo\? url jsonjq-response-body 'delpaths([["respData","freeMarketTabLeadPop"]])'
(?i)^https://app\.zhuanzhuan\.com/zzx/transfer/getConfigInfo\? url jsonjq-response-body 'delpaths([["respData","topOperations"]])'
(?i)^https://app\.zhuanzhuan\.com/zz/v2/zzinfoshow/getfeedflowinfo\? url jsonjq-response-body 'if .respData.userRed.campName == "OCD挂件" then del(.respData.userRed) else . end | .respData.infoData |= map(del(.rotateResource,.appRecommendResource,."cargoGroupCardV2"))'
(?i)^https://app\.zhuanzhuan\.com/zz/v2/zzinfoshow/getwindvanecardv2$ url reject-dict
(?i)^https://app\.zhuanzhuan\.com/zzopen/popwindow/getallpopwin\? url reject-dict
(?i)^https://app\.zhuanzhuan\.com/zzopen/zzbmlogic/queryFrontPageWindowInfo\? url reject-dict
(?i)^https://app\.zhuanzhuan\.com/zzopen/ptuserlogic/subscribehotrecommend$ url reject-dict
(?i)^https://app\.zhuanzhuan\.com/zzopen/ypmall/listData$ url reject-dict
(?i)^https://app\.zhuanzhuan\.com/zz/v2/zzusercenter/myprofilevariouscards$ url reject-dict
(?i)^https://app\.zhuanzhuan\.com/zz/transfer/getmymoretools$ url jsonjq-response-body 'walk(if type == "object" and .name == "免流量特权" then empty else . end) | del(.respData.groupList[] | select(.groupName == "活动参与" or .groupName == "金融工具"))'
(?i)^https://app\.zhuanzhuan\.com/zz/transfer/getmyprofilev3$ url jsonjq-response-body 'delpaths([["respData","bmNewInfo"]])'
(?i)^https://app\.zhuanzhuan\.com/zz/transfer/getmyprofilev3$ url jsonjq-response-body 'del(.respData.itemGroupList[].itemList[] | select(.name == "天天赚钱" or .name == "借钱")) | del(.respData.itemGroupList[] | select(.groupType == 15))'

#!name = 京东去广告
#!desc = 移除京东开屏广告，精简我的页面产品推广。 @RuCu6, @Maasea
hostname = api.m.jd.com

(?i)^https://api\.m\.jd\.com/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06]) url reject-dict
(?i)^https://api\.m\.jd\.com/client\.action\?functionId=basicConfig url jsonjq-response-body 'if (getpath(["data","JDMessage","socketmonitor"]) | has("isSocketEstablishedAhead")) then (setpath(["data","JDMessage","socketmonitor","isSocketEstablishedAhead"]; 0)) else . end'
(?i)^https://api\.m\.jd\.com/client\.action\?functionId=basicConfig url jsonjq-response-body 'if (getpath(["data","JDMessage","socketmonitor"]) | has("isSocketReport")) then (setpath(["data","JDMessage","socketmonitor","isSocketReport"]; 0)) else . end'
(?i)^https://api\.m\.jd\.com/client\.action\?functionId=basicConfig url jsonjq-response-body 'if (getpath(["data","JDHttpToolKit","httpdns"]) | has("httpdns")) then (setpath(["data","JDHttpToolKit","httpdns","httpdns"]; 0)) else . end'
(?i)^https://api\.m\.jd\.com/client\.action\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome) url script-response-body https://raw.githubusercontent.com/Repcz/Tool/X/Loon/Script/JD/JD_remove_ads.js

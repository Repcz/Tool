#!name = 酷安去广告
#!desc = 过滤酷安广告 @RuCu6, @可莉🅥
hostname = api.coolapk.com

(?i)^https://api\.coolapk\.com/v6/search\?.*type=hotSearch url reject-dict
(?i)^https://api\.coolapk\.com/v6/feed/detail\? url jsonjq-response-body '.data.hotReplyRows |= if . then map(select(.id?)) else . end | .data.topReplyRows |= if . then map(select(.id?)) else . end | reduce ("detailSponsorCard", "include_goods", "include_goods_ids") as $key (.; .data[$key]=[])'
(?i)^https://api\.coolapk\.com/v6/feed/replyList url jsonjq-response-body 'if .data? and ((.data | type) == "array") and (.data | length > 0) then .data |= map(select(.id?)) else . end'
(?i)^https://api\.coolapk\.com/v6/main/dataList url jsonjq-response-body '.data |= (if (type=="array" and length>0) then map(select((.entityTemplate!="sponsorCard") and (.title!="精选配件"))) else . end)'
(?i)^https://api\.coolapk\.com/v6/page/dataList url jsonjq-response-body 'if (.data | length > 0) then .data |= map(select((.title? != "酷安热搜") and (.entityTemplate? != "imageScaleCard") and (.entityTemplate? != "sponsorCard"))) else . end'
(?i)^https://api\.coolapk\.com/v6/main/indexV8 url jsonjq-response-body '.data |= (if length > 0 then map(select((.entityTemplate != "sponsorCard") and ([8639,29349,33006,32557] | index(.entityId) | not) and ((.title // "" | test("值得买|红包")) | not))) else . end)'
(?i)^https://api\.coolapk\.com/v6/main/init url jsonjq-response-body '.data |= map(select(.entityId? | [944,945,6390] | index(.) | not) | if .entityId == 20131 then .entities |= map(select(.title != "酷品")) else . end)'

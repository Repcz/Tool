#!name = 百度网盘去广告
#!desc = 移除开屏广告、首页卡片广告、传输页面广告、各类弹窗，精简侧拉抽屉和我的页面。 @可莉🅥
hostname = pan.baidu.com

(?i)^https://pan\.baidu\.com/api/getconfig\? url reject-dict
(?i)^https://pan\.baidu\.com/api/getsyscfg\? url reject-dict
(?i)^https://pan\.baidu\.com/api/taskscore/tasklist\? url reject-dict
(?i)^https://pan\.baidu\.com/act/api/activityentry\? url reject-dict
(?i)^https://pan\.baidu\.com/rest/\d\.\d/pcs/adv\? url reject-dict
(?i)^https://pan\.baidu\.com/api/plugin/get\? url reject-dict
(?i)^https://pan\.baidu\.com/recommend/query/list\? url reject-dict
(?i)^https://pan\.baidu\.com/feed/kingkongdistrict\? url jsonjq-response-body '.data.data |= map(select(.type != "novel" and .type != "shortplay" and .type != "print" and .type != "job_hunt"))'

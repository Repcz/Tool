#!name = 拼多多去广告
#!desc = 移除开屏广告、底栏多多视频、会场入口、聊天页面精选推荐及推广，精简首页和个人中心。 @ZenmoFeiShi, @可莉🅥
hostname = api.pinduoduo.com, m.pinduoduo.net

(?i)^https://api\.pinduoduo\.com/api/aristotle/unrated_order_for_unreceived_tab\? url reject-dict

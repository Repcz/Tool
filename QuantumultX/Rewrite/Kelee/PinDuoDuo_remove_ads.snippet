(?i)^https://api\.pinduoduo\.com/api/caterham/v3/query/new_chat_group\? url reject-dict
(?i)^https://api\.pinduoduo\.com/api/alexa/goods/back_up\? url reject-dict
(?i)^https://api\.pinduoduo\.com/api/caterham/v3/query/personal\? url reject-dict

#!name = HTTPDNS拦截器
#!desc = 此插件是所有去广告插件的依赖，拦截常见的HTTPDNS服务，以确保这些请求都能够在Loon的DNS框架下工作。 @可莉🅥, @VirgilClyne
hostname = appconf.mail.163.com, msglb.91160.com, ucdc2-upaas.uc.cn, gw-cn.jiaoliuqu.com

(?i)^https?://appconf\.mail\.163\.com/mailmaster/api/http/urlConfig\.do$ url reject-dict
(?i)^https?://cdn\.wup\.huya\.com/monitor/monitor\.jsp url reject
(?i)^https://msglb\.91160\.com/msg/outer/broker/get$ url reject-dict
(?i)^https://gslbali\.ximalaya\.com/linkeye-cloud/httpdns/ url reject
(?i)^https://ucdc\d?-upaas\.uc\.cn/api/v\d/dns_query\? url reject-dict
(?i)^https://gw-cn\.jiaoliuqu\.com/taqu-im-broadcast-srv/v\d/Comet/get\? url reject-dict

user-agent, "httpdns*", reject
user-agent, "httpsdns*", reject
user-agent, "Httpdns*", reject
user-agent, "Httpsdns*", reject

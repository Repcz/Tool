#!name = 滴滴去广告
#!desc = 移除开屏广告、弹窗广告、横幅推广，精简我的页面。 @可莉🅥
hostname = as.xiaojukeji.com, conf.diditaxi.com.cn, common.diditaxi.com.cn, res.xiaojukeji.com, api.udache.com, daijia.kuaidadi.com, htwkop-st.xiaojukeji.com, htwkop.xiaojukeji.com, freight.xiaojukeji.com, poi.map.xiaojukeji.com

(?i)^https://as\.xiaojukeji\.com/ep/as/toggles\? url jsonjq-response-body '.data |= map(select(.name != "isUseNetConnectivity") | .assign.args.rootca_pin = 0 | .assign.args.sni_list = {})'
(?i)^https://conf\.diditaxi\.com\.cn/homepage/v\d/other/slow\? url jsonjq-response-body 'delpaths([["data","order_cards","new_loss_banner_card"]])'
(?i)^https://conf\.diditaxi\.com\.cn/homepage/v\d/other/slow\? url jsonjq-response-body 'delpaths([["data","order_cards","call_car_card_80"]])'
(?i)^https://conf\.diditaxi\.com\.cn/homepage/v\d/core\? url jsonjq-response-body '.data.order_cards.nav_list_card.data |= map(select(.nav_id == "dache_anycar" or .nav_id == "carmate" or .nav_id == "driverservice" or .nav_id == "zhandianbashi" or .nav_id == "pincheche" or .nav_id == "bike" or .nav_id == "nav_more_v3")) | .data.disorder_cards.top_nav_list.data.top_nav_info |= map(select(.nav_id == "chu_xing" or .nav_id == "freight_cargo"))'
(?i)^https://conf\.diditaxi\.com\.cn/homepage/v\d/other/fast\? url jsonjq-response-body 'delpaths([["data","disorder_cards","communicate_card"]])'
(?i)^https://conf\.diditaxi\.com\.cn/homepage/v\d/other/fast\? url jsonjq-response-body 'delpaths([["data","disorder_cards","not_login_bottom_bar"]])'
(?i)^https://conf\.diditaxi\.com\.cn/homepage/v\d/other/fast\? url jsonjq-response-body 'delpaths([["data","disorder_cards","riding_code_card"]])'
(?i)^https://conf\.diditaxi\.com\.cn/homepage/v\d/other/fast\? url jsonjq-response-body 'delpaths([["data","order_cards"]])'
(?i)^https://conf\.diditaxi\.com\.cn/homepage/v\d/other/fast\? url jsonjq-response-body 'delpaths([["data","disorder_cards","car_icon","data","icon_info_new_agreement"]])'
(?i)^https://common\.diditaxi\.com\.cn/common/v\d/usercenter/layout url jsonjq-response-body '.data |= (.instances |= (to_entries | map(select(.key as $k | ["center_base_info_card", "center_tool_card", "center_wallet_finance_card", "center_order_related_card"] | index($k))) | from_entries)) | .data.instances.center_wallet_finance_card.data.view_info |= map(select(.title == "优惠卡券"))'
(?i)^https://res\.xiaojukeji\.com/resapi/activity/mget\? url reject-dict
(?i)^https://res\.xiaojukeji\.com/resapi/activity/mget$ url reject-dict
(?i)^https://conf\.diditaxi\.com\.cn/homepage/v\d/other/fast\? url jsonjq-response-body 'delpaths([["data","disorder_cards","guess_card"]])'
(?i)^https://conf\.diditaxi\.com\.cn/homepage/v\d/other/fast\? url jsonjq-response-body 'delpaths([["data","disorder_cards","scene_list_card"]])'
(?i)^https://api\.udache\.com/gulfstream/porsche/v\d/dache_homepage_layout\? url jsonjq-response-body 'delpaths([["data","instances","dache_main_core_icon"]])'
(?i)^https://api\.udache\.com/gulfstream/porsche/v\d/dache_homepage_layout\? url jsonjq-response-body '.data |= (.instances |= (to_entries | map(select(.key | test("feed_back_|dache_main_member|order_container_|dache_main_core_icon|dache_main_card_"))) | from_entries))'
(?i)^https://api\.udache\.com/intercity/ticket/api/v\d/core/getFullPageInfoLayout\? url jsonjq-response-body '.data.disorder_components |= (map(select(.name == "history_order_card" or .name == "inprogress_order_card" or .name == "station_calendar" or .name == "main_card_v2" or .name == "user_history_order")))'
(?i)^https://daijia\.kuaidadi\.com(:443)?/gateway\?api=prado\.cms\.delivery\.batch url reject-dict
(?i)^https://daijia\.kuaidadi\.com(:443)?/gateway\?api=prado\.cms\.AggregateDeliveryRemoteService\.aggregateDelivery url reject-dict
(?i)^https://daijia\.kuaidadi\.com(:443)?/gateway\?api=lj\.cos\.apolloConfig url jsonjq-response-body '.data |= map(select(.name != "daijia-memberInfo-config" and .name != "daijia-transfer-share-config"))'
(?i)^https://daijia\.kuaidadi\.com(:443)?/gateway\?api=lj\.c\.p\.queryLevelAndRightsStatus url reject-dict
(?i)^https://daijia\.kuaidadi\.com(:443)?/gateway\?api=lj\.cos\.p\.popup url reject-dict
(?i)^https://daijia\.kuaidadi\.com(:443)?/gateway\?api=lj\.cos\.apolloToggle url jsonjq-response-body '.data |= map(select(.name as $n | {daijia_app_estimate_pre_req_switch:true,daijia_agent_car_picture_check:true,daijia_bluetooth_wifi_degrade_switch:true,daijia_weixin_publish_login:true,daijia_estimate_recommend_degrade_switch:true,daijia_yugu_policy_switch:true,daijia_home_location_guide_switch:true,daijia_estimate_switch:true} | has($n)))'
(?i)^https://api\.udache\.com/gulfstream/porsche/v\d/bronze/pinchengle_homepage_layout$ url jsonjq-response-body '.data.instances |= with_entries(select(.key | IN("dacheanycar-certificates-1", "main-card-1", "map-1", "nav-1", "tool-container-1")))'
(?i)^https://api\.udache\.com/gulfstream/porsche/v\d/pSFCHomePage\? url reject-dict
(?i)^https://api\.udache\.com/gulfstream/porsche/v\d/SFCHomeTab\? url jsonjq-response-body '.data.tab_list |= map(select(.tab_id == "passenger" or .tab_id == "driver"))'
(?i)^https://htwkop-st\.xiaojukeji\.com/gateway\?api=cms\.htw\.delivery\.batch url reject-dict
(?i)^https://freight\.xiaojukeji\.com/gateway\?api=freight\.d\.core\.multiDisplayV\d url reject-dict
(?i)^https://poi\.map\.xiaojukeji\.com/mapapi/startinfo\?api_version url jsonjq-response-body 'delpaths([["rec_destination"]])'
(?i)^https://poi\.map\.xiaojukeji\.com/mapapi/poiinfo\?product_id url jsonjq-response-body 'delpaths([["rec_destination"]])'
(?i)^https://common\.diditaxi\.com\.cn/user_common/itineraryList\? url jsonjq-response-body 'del(.data.tab_nav[]?.tab_param)'

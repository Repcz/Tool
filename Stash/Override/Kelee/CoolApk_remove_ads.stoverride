name: '酷安去广告'
desc: |-
  过滤酷安广告
  @RuCu6, @可莉🅥
icon: 'https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/CoolApk.png'
date: '2026-10-02 13:57:49'
category: '⚙️ ▸ Kelee Mode'
http:
  mitm: #!append
    - 'api.coolapk.com'
  url-rewrite:
    - '(?i)^https://api\.coolapk\.com/v6/search\?.*type=hotSearch - reject-dict'
  body-rewrite:
    - '(?i)^https://api\.coolapk\.com/v6/feed/detail\? response-jq .data.hotReplyRows |= if . then map(select(.id?)) else . end | .data.topReplyRows |= if . then map(select(.id?)) else . end | reduce ("detailSponsorCard", "include_goods", "include_goods_ids") as $key (.; .data[$key]=[])'
    - '(?i)^https://api\.coolapk\.com/v6/feed/replyList response-jq if .data? and ((.data | type) == "array") and (.data | length > 0) then .data |= map(select(.id?)) else . end'
    - '(?i)^https://api\.coolapk\.com/v6/main/dataList response-jq .data |= (if (type=="array" and length>0) then map(select((.entityTemplate!="sponsorCard") and (.title!="精选配件"))) else . end)'
    - '(?i)^https://api\.coolapk\.com/v6/page/dataList response-jq if (.data | length > 0) then .data |= map(select((.title? != "酷安热搜") and (.entityTemplate? != "imageScaleCard") and (.entityTemplate? != "sponsorCard"))) else . end'
    - '(?i)^https://api\.coolapk\.com/v6/main/indexV8 response-jq .data |= (if length > 0 then map(select((.entityTemplate != "sponsorCard") and ([8639,29349,33006,32557] | index(.entityId) | not) and ((.title // "" | test("值得买|红包")) | not))) else . end)'
    - '(?i)^https://api\.coolapk\.com/v6/main/init response-jq .data |= map(select(.entityId? | [944,945,6390] | index(.) | not) | if .entityId == 20131 then .entities |= map(select(.title != "酷品")) else . end)'

name: '京东去广告'
desc: |-
  移除京东开屏广告，精简我的页面产品推广。
  @RuCu6[https://github.com/RuCu6], Maasea[https://github.com/Maasea]
author: 'RuCu6[https://github.com/RuCu6], Maasea[https://github.com/Maasea]'
homepage: 'https://hub.kelee.one'
icon: 'https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/JD.png'
category: '去广告'
date: '2026-10-02 13:57:49'
openUrl: 'https://apps.apple.com/app/id414245413'
http:
  mitm: #!append
    - 'api.m.jd.com'
  url-rewrite:
    - '(?i)^https://api\.m\.jd\.com/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06]) - reject-dict'
  body-rewrite:
    - '(?i)^https://api\.m\.jd\.com/client\.action\?functionId=basicConfig response-jq if (getpath(["data","JDMessage","socketmonitor"]) | has("isSocketEstablishedAhead")) then (setpath(["data","JDMessage","socketmonitor","isSocketEstablishedAhead"]; 0)) else . end'
    - '(?i)^https://api\.m\.jd\.com/client\.action\?functionId=basicConfig response-jq if (getpath(["data","JDMessage","socketmonitor"]) | has("isSocketReport")) then (setpath(["data","JDMessage","socketmonitor","isSocketReport"]; 0)) else . end'
    - '(?i)^https://api\.m\.jd\.com/client\.action\?functionId=basicConfig response-jq if (getpath(["data","JDHttpToolKit","httpdns"]) | has("httpdns")) then (setpath(["data","JDHttpToolKit","httpdns","httpdns"]; 0)) else . end'
  script:
    - match: '(?i)^https://api\.m\.jd\.com/client\.action\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome)'
      name: '移除京东广告'
      type: 'response'
      require-body: true
script-providers:
  '移除京东广告':
    url: 'https://raw.githubusercontent.com/Repcz/Tool/X/Loon/Script/JD/JD_remove_ads.js'
    interval: 86400
rules:
  - 'URL-REGEX,"^http:\/\/\w{32}\.jddebug\.com\/diagnose\?",REJECT'

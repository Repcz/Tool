name: '转转去广告'
desc: |-
  移除开屏广告、应用内悬浮窗、信息流推广、商品推荐、首页弹窗，精简我的页面。
  @可莉🅥
icon: 'https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ZhuanZhuan.png'
date: '2026-10-02 13:57:49'
category: '⚙️ ▸ Kelee Mode'
http:
  mitm: #!append
    - 'app.zhuanzhuan.com'
  url-rewrite:
    - '(?i)^https://app\.zhuanzhuan\.com/zz/v2/zzlogic/getOpenScreen$ - reject-dict'
    - '(?i)^https://app\.zhuanzhuan\.com/zz/v2/zzinfoshow/getwindvanecardv2$ - reject-dict'
    - '(?i)^https://app\.zhuanzhuan\.com/zzopen/popwindow/getallpopwin\? - reject-dict'
    - '(?i)^https://app\.zhuanzhuan\.com/zzopen/zzbmlogic/queryFrontPageWindowInfo\? - reject-dict'
    - '(?i)^https://app\.zhuanzhuan\.com/zzopen/ptuserlogic/subscribehotrecommend$ - reject-dict'
    - '(?i)^https://app\.zhuanzhuan\.com/zzopen/ypmall/listData$ - reject-dict'
    - '(?i)^https://app\.zhuanzhuan\.com/zz/v2/zzusercenter/myprofilevariouscards$ - reject-dict'
  body-rewrite:
    - '(?i)^https://app\.zhuanzhuan\.com/zz/v2/zzlogic/mycontinenthomepage\? response-jq delpaths([["respData","topOpera","leftOpera"]])'
    - '(?i)^https://app\.zhuanzhuan\.com/zz/v2/zzlogic/mycontinenthomepage\? response-jq delpaths([["respData","topOpera","rightOpera2"]])'
    - '(?i)^https://app\.zhuanzhuan\.com/zz/v2/zzlogic/mycontinenthomepage\? response-jq delpaths([["respData","topActBanner"]])'
    - '(?i)^https://app\.zhuanzhuan\.com/zz/v2/zzlogic/mycontinenthomepage\? response-jq delpaths([["respData","bmArea"]])'
    - '(?i)^https://app\.zhuanzhuan\.com/zzx/transfer/getConfigInfo\? response-jq delpaths([["respData","freeMarketTabLeadPop"]])'
    - '(?i)^https://app\.zhuanzhuan\.com/zzx/transfer/getConfigInfo\? response-jq delpaths([["respData","topOperations"]])'
    - '(?i)^https://app\.zhuanzhuan\.com/zz/v2/zzinfoshow/getfeedflowinfo\? response-jq if .respData.userRed.campName == "OCD挂件" then del(.respData.userRed) else . end | .respData.infoData |= map(del(.rotateResource,.appRecommendResource,."cargoGroupCardV2"))'
    - '(?i)^https://app\.zhuanzhuan\.com/zz/transfer/getmymoretools$ response-jq walk(if type == "object" and .name == "免流量特权" then empty else . end) | del(.respData.groupList[] | select(.groupName == "活动参与" or .groupName == "金融工具"))'
    - '(?i)^https://app\.zhuanzhuan\.com/zz/transfer/getmyprofilev3$ response-jq delpaths([["respData","bmNewInfo"]])'
    - '(?i)^https://app\.zhuanzhuan\.com/zz/transfer/getmyprofilev3$ response-jq del(.respData.itemGroupList[].itemList[] | select(.name == "天天赚钱" or .name == "借钱")) | del(.respData.itemGroupList[] | select(.groupType == 15))'
  mock:
    - match: '(?i)^https://app\.zhuanzhuan\.com/zzopen/ptsimpleshow/recommendbymyloveinfo\?'
      text: '{"respCode":0,"errorMsg":"null","errMsg":""}'
      status-code: 200
      headers:
        Content-Type: 'application/json'
    - match: '(?i)^https://app\.zhuanzhuan\.com/zz/v2/zzinfoshow/footprintsamerecommend\?'
      text: '{"respCode":0,"errorMsg":"","errMsg":""}'
      status-code: 200
      headers:
        Content-Type: 'application/json'
    - match: '(?i)^https://app\.zhuanzhuan\.com/zz/v2/zzinfoshow/getchoicegoodsinfos\?'
      text: '{"respCode":0,"respData":{},"errorMsg":"","errMsg":""}'
      status-code: 200
      headers:
        Content-Type: 'application/json'

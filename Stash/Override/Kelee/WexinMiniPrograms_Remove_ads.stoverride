  script:
    - match: '(?i)^https://webapi\.qmai\.cn/web/catering/design/homePage-Config'
      name: '企迈点单系统去广告'
      type: 'response'
      require-body: true
    - match: '(?i)^https://ump\.ems\.com\.cn/new-generation-extend/redis/pageInfoByChannel'
      name: 'EMS中国邮政物流速递去广告'
      type: 'response'
      require-body: true
    - match: '(?i)^https://mapi\.xiaotucc\.com/(mall/main|main_page/index/getActivity)'
      name: '小兔充充去广告'
      type: 'response'
      require-body: true
    - match: '(?i)^https://minifm\.maxxipoint\.com/banner/list'
      name: '全家微会员去广告'
      type: 'response'
      require-body: true
    - match: '(?i)^https://lawsonapi\.yorentown\.com/area/sh-lawson/app/v1/home'
      name: '罗森点点去广告'
      type: 'response'
      require-body: true
    - match: '(?i)^https://miniapp\.sexytea2013\.com/cms/slot/queryByCodes\?codes=INDEX_TOP_BANNER'
      name: '茶颜悦色去广告'
      type: 'response'
      require-body: true
    - match: '(?i)^https://coco-com\.e\.verystar\.net/v1/home/info'
      name: 'COCO点单去广告'
      type: 'response'
      require-body: true
    - match: '(?i)^https://htwkop\.xiaojukeji\.com/gateway\?api=hm\.fa\.homeConfig'
      name: '滴滴青桔去广告'
      type: 'response'
      require-body: true
    - match: '(?i)^https://cappapi\.alittle-tea\.com/open\?method=catering\.set\.ad'
      name: '一点点_去广告'
      type: 'response'
      require-body: true
    - match: '(?i)^https://api\.prod\.dj\.mstand\.cn/scrm/mini/app/index/info'
      name: 'M_Stand去广告'
      type: 'response'
      require-body: true
    - match: '(?i)^https://passenger\.t3go\.cn/(solution\-|common\-)?(passenger\-)?(activity\-|app\-)?api/notoken/(trip/)?api/(home/|common/)?(v[1-3]/)?(ad/getNegativescreen|solution/passenger/open/getHomeMenu|leftmenu|getHomeInfoGlobal)'
      name: 'T3出行去广告'
      type: 'response'
      require-body: true
    - match: '(?i)^https://newton\.gumingnc\.com/newton-buyer/newton/buyer/(ump|touch|external/front)'
      name: '古茗去广告'
      type: 'response'
      require-body: true
